# Copy to .env.production and replace every placeholder.
NODE_ENV=production
APP_ORIGIN=https://your-domain.example

# Vercel Blob: required for local Blob uploads. On Vercel, OIDC can be used automatically when the Blob store is connected.
BLOB_READ_WRITE_TOKEN=""
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
DATABASE_URL=postgresql://gamevortex:CHANGE_ME@postgres:5432/gamevortex
AUTH_SECRET=REPLACE_WITH_64_PLUS_RANDOM_CHARACTERS
OWNER_EMAIL=owner@example.com
OWNER_NAME=owner
OWNER_USERNAME=owner
OWNER_INITIAL_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
REQUIRE_OWNER_BOOTSTRAP=1
OWNER_WITHDRAWAL_ENABLED=false
OWNER_EXTERNAL_WALLET_ADDRESS=
OWNER_POINTS_PER_USD=30
OWNER_MIN_WITHDRAW_POINTS=15
TRADING_MAX_ALLOCATION_USD=1000
QURAN_PROVIDER_BASE_URL=
QURAN_PROVIDER_API_KEY=
PAYMENT_PROVIDER_BASE_URL=
PAYMENT_PROVIDER_SECRET=
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
# Generate with: openssl rand -base64 48
DIGITAL_KEY_ENCRYPTION_SECRET=
RATE_LIMIT_STORE=memory

# Optional distributed rate limiting (recommended with >1 app instance)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Payments: set PAYMENT_PROVIDER=stripe and a Stripe secret/webhook signing secret
STRIPE_SECRET_KEY=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_SECRET=
PAYPAL_CLIENT_ID=
STRIPE_WEBHOOK_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Gaming
STEAM_API_KEY=
XBOX_API_BASE_URL=
PLAYSTATION_API_BASE_URL=

# Owner payouts
PAYOUT_PROVIDER=
PAYOUT_PROVIDER_BASE_URL=
PAYOUT_PROVIDER_SECRET=

# Mobile game catalog import (server-side only)
RAWG_API_KEY=
RAWG_MOBILE_IMPORT_TARGET=1000
RAWG_MOBILE_IMPORT_PAGE_SIZE=40

# GameVortex AI providers — server-side only
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_SIZE=1K
GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash
GEMINI_VIDEO_ASPECT_RATIO=9:16
GEMINI_VIDEO_RESOLUTION=720p
MANUS_API_KEY=
MANUS_API_BASE_URL=https://api.manus.ai
MANUS_AGENT_PROFILE=standard

# Optional integrations / validation controls
FAZER_API_KEY=""
QF_CLIENT_ID=""
QF_CLIENT_SECRET=""
QF_ENV="sandbox"
OWNER_PURCHASE_POINTS="0"
REFERRAL_REFERRER_POINTS="0"
REFERRAL_REFERRED_POINTS="0"
REQUIRE_BUILD="0"
REQUIRE_LOCKFILE="1"

GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_SIZE=1K

VALIDATE_PRODUCTION=0

# Trading wallet: max single allocation in whole USD (default 1000 if empty/invalid).
TRADING_MAX_ALLOCATION_USD="1000"

# Binance Spot Testnet — server-side only. Never use NEXT_PUBLIC_.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Binance Spot Production preflight — keep empty until live-execution prerequisites are complete.
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=
# Optional Ed25519 PKCS#8 private key; keep server-side and never commit it.
BINANCE_LIVE_API_PRIVATE_KEY=
# Must remain false/unset until protected exits, reconciliation, settlement, emergency-stop and first-live-order review are complete.
GAMEVORTEX_LIVE_TRADING_ENABLED=false
# Opt-in: trade the owner's OWN Binance balance without an Owner Wallet allocation.
# Wallet/ledger are not touched in this mode. Leave "false" to require a wallet allocation.
GAMEVORTEX_LIVE_DIRECT_FUNDING=false
# Max adverse price move (percent, 0.05-5) between the approved price and the price at submission. Default 0.5.
TRADING_LIVE_MAX_SLIPPAGE_PERCENT=0.5
# Secret (16+ chars) that protects /api/cron/trading-live-monitor. Vercel Cron sends it automatically.
CRON_SECRET=

# Public site origin (used by wallpaper delivery fallback)
NEXT_PUBLIC_SITE_URL=

# Bybit Spot production — server-side only. Keep live trading disabled until review.
BYBIT_LIVE_API_KEY=
BYBIT_LIVE_API_SECRET=
BYBIT_LIVE_BASE_URL=https://api.bybit.com
GAMEVORTEX_LIVE_EXCHANGE=BINANCE

# Manus API — server-side only
MANUS_API_KEY=
MANUS_API_BASE_URL=https://api.manus.ai
CHAT_COST=1
ADVANCED_CHAT_COST=3
IMAGE_COST=10
IMAGE_EDIT_COST=15
HIGH_QUALITY_IMAGE_COST=20
VIDEO_COST=50
VIDEO_EDIT_COST=100
