# GameVortex AI self-hosted Ollama gateway (server only).
# For local development only, Ollama can use http://127.0.0.1:11434 without a token.
# On Vercel, use your own HTTPS gateway URL and the same random 32+ character token configured there.
GAMEVORTEX_AI_RUNTIME_URL="http://127.0.0.1:11434"
GAMEVORTEX_AI_MODEL="qwen3:1.7b"
