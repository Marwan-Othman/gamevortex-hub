# ============================================================
# GameVortex AI — Three-provider setup (server-side only)
# NEVER prefix these with NEXT_PUBLIC_ — that would expose them
# to the browser bundle. These are read only inside API routes
# and lib/ files that run on the server (Node.js runtime).
# ============================================================

# OpenAI — "the brain" (chat / reasoning / text generation)
OPENAI_API_KEY=""

# Central model config (lib/ai/config.ts reads these).
# Leave empty to use the defaults defined there (gpt-6-astra,
# reasoning effort "medium", 2000 max output tokens, 60s timeout).
OPENAI_MODEL=""
# low | medium | high | xhigh | max
OPENAI_REASONING_EFFORT=""
OPENAI_MAX_OUTPUT_TOKENS=""
OPENAI_TIMEOUT_MS=""

# fal.ai — media (image generation/processing)
# Auth format used by fal.ai: "Authorization: Key <FAL_KEY>"
FAL_KEY=""

# MiniMax — video/media generation
MINIMAX_API_KEY=""
# Region-specific base URL. International accounts use
# https://api.minimax.io — Mainland China accounts use
# https://api.minimaxi.com. Leave empty to default to
# the international endpoint.
MINIMAX_API_BASE_URL=""
