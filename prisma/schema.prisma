generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  STAFF
  USER
}

enum PlatformType {
  PC
  PLAYSTATION
  XBOX
  NINTENDO
  ANDROID
  IOS
  MAC
  LINUX
  STEAM_DECK
  WEB
}

enum SourceStatus {
  VERIFIED
  NEEDS_SOURCE
  PENDING_REVIEW
  UNPUBLISHED
  OFFICIAL_SOURCE
  NEEDS_LICENSE
  STREAM_ONLY
}

enum LibraryStatus {
  WANT
  PLAYING
  BEATEN
  ARCHIVED
}

enum WithdrawalStatus {
  REQUESTED
  PENDING
  PROCESSING
  PAID
  SETTLED
  FAILED
  REJECTED
  CANCELLED
  REVERSED
}

enum LedgerType {
  CREDIT_POINTS
  CREDIT_REVENUE
  DEBIT_PAYOUT
  REFUND
  REVERSAL
  ADJUSTMENT
  PENDING
  SETTLED
  POINTS_WITHDRAWAL_REQUESTED
  POINTS_RESERVED
  POINTS_DEBITED
  PAYOUT_PENDING
  PAYOUT_SETTLED
  PAYOUT_FAILED
  POINTS_RETURNED
}

enum PointLedgerType {
  CREDIT
  DEBIT
  REFUND
  REVERSAL
  ADJUSTMENT
}

model User {
  id String @id @default(cuid())
  email String @unique
  username String? @unique
  role Role @default(USER)
  passwordHash String?
  sessionVersion Int @default(1)
  emailVerifiedAt DateTime?
  points Int @default(0)
  ownerPoints Int @default(0)
  vipTier VipTier @default(BRONZE)
  referralCode String? @unique

  wallet Wallet?
  walletTransactions WalletTransaction[]
  walletDeposits WalletDeposit[]
  ownerWallet OwnerWallet?

  pointLedger PointLedger[]

  library GameLibraryItem[]
  reviews Review[]
  favorites FavoriteGame[]
  wishlist WishlistGame[]
  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gamerProfile GamerProfile?

  following UserFollow[] @relation("Following")
  followers UserFollow[] @relation("Followers")

  activities Activity[]
  notifications Notification[]
  orders Order[]

  referralsMade Referral[] @relation("ReferralReferrer")
  referralReceived Referral? @relation("ReferralReferred")

  raffleEntries RaffleEntry[]
  raffleWins Raffle[] @relation("RaffleWinner")

  entitlements Entitlement[]

  reportsFiled ContentReport[] @relation("ReporterReports")
  moderationActions ModerationAction[]
  reportsModerated ContentReport[] @relation("ModeratorReports")

  vipSubscriptions VipSubscription[]
  vipRewardClaims VipRewardClaim[]
  vipPurchases VipPurchase[]

  conversations Conversation[]
}

model PointLedger {
  id String @id @default(cuid())

  userId String
  type PointLedgerType

  amount Int
  balanceAfter Int

  reason String
  sourceId String?
  idempotencyKey String @unique

  metadata Json?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, type, createdAt])
  @@index([sourceId])
}

model Wallet {
  id String @id @default(cuid())
  userId String @unique

  balance Decimal @default(0) @db.Decimal(18,2)
  pendingBalance Decimal @default(0) @db.Decimal(18,2)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum WalletTransactionType {
  DEPOSIT
  WITHDRAWAL
  PURCHASE
  REFUND
  ADJUSTMENT
}

enum WalletDepositStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

model WalletDeposit {
  id String @id @default(cuid())
  userId String
  amountCents Int
  currency String @default("USD")
  provider String
  providerPaymentId String?
  status WalletDepositStatus @default(PENDING)
  idempotencyKey String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerPaymentId])
  @@index([userId, status, createdAt])
}

model WalletTransaction {
  id String @id @default(cuid())
  userId String
  walletId String
  type WalletTransactionType
  amount Decimal @db.Decimal(18,2)
  balanceBefore Decimal @db.Decimal(18,2)
  balanceAfter Decimal @db.Decimal(18,2)
  currency String @default("USD")
  referenceType String?
  referenceId String?
  idempotencyKey String @unique
  metadata Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([walletId, createdAt])
  @@index([referenceType, referenceId])
}

model OwnerWallet {
  id String @id @default(cuid())
  ownerId String @unique

  availablePoints Int @default(0)
  pendingPoints Int @default(0)

  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  ledger OwnerLedger[]
  withdrawals WithdrawalRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OwnerLedger {
  id String @id @default(cuid())

  walletId String
  type LedgerType

  points Int @default(0)
  usdAmount Decimal? @db.Decimal(18,2)

  currency String?
  conversionRate Int?

  withdrawalId String?
  provider String?
  providerTransactionId String?
  transactionHash String?

  idempotencyKey String @unique

  metadata Json?

  createdAt DateTime @default(now())

  wallet OwnerWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
}

model Game {
  id String @id @default(cuid())

  slug String @unique

  titleAr String
  titleEn String

  description String?

  platform String?
  genre String?

  priceCents Int @default(0)
  discountPercent Int @default(0)

  coverUrl String?
  officialUrl String?
  downloadSource String?

  sourceStatus SourceStatus @default(NEEDS_SOURCE)
  sourceProvider String?

  ratingAverage Float @default(0)
  ratingCount Int @default(0)

  playCount Int @default(0)
  viewCount Int @default(0)
  downloadCount Int @default(0)

  published Boolean @default(false)
  featured Boolean @default(false)

  reviews Review[]
  libraryItems GameLibraryItem[]
  activities Activity[]
  products GameProduct[]

  gamePlatforms GamePlatform[]

  entitlements Entitlement[]
  favorites FavoriteGame[]
  wishlists WishlistGame[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GamePlatform {
  id String @id @default(cuid())

  gameId String
  platform PlatformType

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([gameId, platform])
  @@index([platform, gameId])
}

model Review {
  id String @id @default(cuid())

  userId String
  gameId String

  rating Int
  text String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, gameId])
  @@index([gameId, rating])
  @@index([userId, createdAt])
}

model GameLibraryItem {
  id String @id @default(cuid())

  userId String
  gameId String

  status LibraryStatus @default(WANT)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, gameId])
  @@index([userId, status, updatedAt])
  @@index([gameId, status])
}

model WithdrawalRequest {
  id String @id @default(cuid())

  ownerWalletId String

  points Int
  usdAmount Decimal @db.Decimal(18,2)

  conversionRate Int @default(30)
  currency String @default("USD")

  provider String?
  providerTransactionId String?
  transactionHash String?

  status WithdrawalStatus @default(REQUESTED)

  failureReason String?

  idempotencyKey String @unique

  createdAt DateTime @default(now())
  processedAt DateTime?

  ownerWallet OwnerWallet @relation(fields: [ownerWalletId], references: [id], onDelete: Restrict)
}

model AuditLog {
  id String @id @default(cuid())

  actorUserId String?

  action String
  entityType String
  entityId String?

  ip String?

  metadata Json?

  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([createdAt])
}

model SystemError {
  id String @id @default(cuid())

  scope String
  message String

  statusCode Int?

  userId String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([scope, createdAt])
  @@index([createdAt])
}

model QuranReciter {
  id String @id @default(cuid())

  nameAr String
  nameEn String

  riwayah String?
  style String?
  quality String?

  provider String

  legalSourceUrl String
  licenseUrl String?
  licenseStatus String

  sourceVerificationStatus SourceStatus @default(PENDING_REVIEW)

  verificationDate DateTime?
  verifiedBy String?

  audioBaseUrl String

  availableSurahs Json?

  notes String?

  sortOrder Int @default(0)
  active Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sourceVerificationStatus, sortOrder])
}

model FavoriteGame {
  id String @id @default(cuid())

  userId String
  gameId String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId])
  @@index([userId, createdAt])
}

model WishlistGame {
  id String @id @default(cuid())

  userId String
  gameId String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId])
  @@index([userId, createdAt])
}

/* =========================================================
   GAMER PROGRESS SYSTEM
   ========================================================= */

enum AchievementRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

model GamerProfile {
  id String @id @default(cuid())

  userId String @unique

  displayName String?
  bio String?
  avatarUrl String?
  bannerUrl String?

  favoritePlatform String?
  country String?

  level Int @default(1)
  xp Int @default(0)

  totalPlayMinutes Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  achievements UserAchievement[]
  xpEvents XpEvent[]

  @@index([level])
  @@index([xp])
}

model Achievement {
  id String @id @default(cuid())

  key String @unique

  name String
  description String

  icon String?

  rarity AchievementRarity @default(COMMON)

  xpReward Int @default(0)

  createdAt DateTime @default(now())

  users UserAchievement[]
}

model UserAchievement {
  id String @id @default(cuid())

  profileId String
  achievementId String

  unlockedAt DateTime @default(now())

  profile GamerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([profileId, achievementId])
  @@index([profileId])
}

model XpEvent {
  id String @id @default(cuid())

  profileId String

  amount Int
  reason String

  sourceId String?

  createdAt DateTime @default(now())

  profile GamerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
}

enum ActivityType {
  FAVORITED_GAME
  WISHLISTED_GAME
  REVIEWED_GAME
  ADDED_TO_LIBRARY
  COMPLETED_GAME
  ACHIEVEMENT_UNLOCKED
  LEVEL_UP
  REFERRAL_REWARDED
  RAFFLE_ENTERED
  RAFFLE_WON
}

model UserFollow {
  id String @id @default(cuid())

  followerId String
  followingId String

  createdAt DateTime @default(now())

  follower User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
  @@index([followerId, createdAt])
}

model Activity {
  id String @id @default(cuid())

  userId String

  type ActivityType

  gameId String?

  message String?

  metadata Json?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game? @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([gameId, createdAt])
}

model Notification {
  id String @id @default(cuid())

  userId String

  type String
  title String
  body String?

  readAt DateTime?

  metadata Json?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

/* =========================================================
   MARKETPLACE
   ========================================================= */

enum ProductKind {
  GAME_KEY
  GIFT_CARD
  TOP_UP
  DLC
  SUBSCRIPTION
  DIGITAL_ITEM
}

enum DeliveryType {
  CODE
  ACCOUNT_TOPUP
  EXTERNAL_LINK
  MANUAL
}

enum DigitalKeyStatus {
  AVAILABLE
  DELIVERED
  REVOKED
}

enum VipTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
  APEX
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REWARDED
  REJECTED
}

enum RaffleStatus {
  DRAFT
  OPEN
  DRAWN
  CANCELLED
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLING
  COMPLETED
  REFUNDED
  CANCELLED
  FAILED
}

enum PaymentStatus {
  CREATED
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  REFUNDED
}

enum VipSubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELED
  REFUNDED
  PAYMENT_FAILED
}

enum VipSubscriptionEventType {
  CREATED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  ACTIVATED
  RENEWED
  UPGRADED
  CANCELED
  EXPIRED
  REFUNDED
  CREDITS_RESET
}




enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum ReportReason {
  SPAM
  ABUSE
  FRAUD
  COPYRIGHT
  NSFW
  MISLEADING
  OTHER
}

model GameProduct {
  id String @id @default(cuid())

  gameId String

  sku String @unique

  title String
  description String?

  priceCents Int

  currency String @default("USD")

  active Boolean @default(true)

  inventory Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kind ProductKind @default(GAME_KEY)

  deliveryType DeliveryType @default(CODE)

  region String?
  country String?

  denominationCents Int?

  provider String?

  fazerCategoryId String?
  fazerCardId String?

  redemptionInstructions String?

  sourceUrl String?

  supplierVerified Boolean @default(false)

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  orderItems OrderItem[]
  digitalKeys DigitalKey[]

  @@index([gameId, active])
}

model Order {
  id String @id @default(cuid())

  userId String

  status OrderStatus @default(PENDING)

  subtotalCents Int
  totalCents Int

  currency String @default("USD")

  paymentStatus PaymentStatus @default(CREATED)

  paymentProvider String?
  providerOrderId String?

  idempotencyKey String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  items OrderItem[]
  payments Payment[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id String @id @default(cuid())

  orderId String
  productId String

  quantity Int @default(1)

  unitPriceCents Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product GameProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  digitalKeys DigitalKey[]

  @@index([productId])
}

model DigitalKey {
  id String @id @default(cuid())

  productId String
  orderItemId String?

  ciphertext String

  fingerprint String @unique

  status DigitalKeyStatus @default(AVAILABLE)

  deliveredAt DateTime?
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product GameProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([productId, status, createdAt])
  @@index([orderItemId, status])
}

model Payment {
  id String @id @default(cuid())

  orderId String

  provider String
  providerPaymentId String?

  status PaymentStatus @default(CREATED)

  amountCents Int

  currency String @default("USD")

  rawEvent Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([provider, providerPaymentId])
  @@index([orderId, createdAt])
}

model Entitlement {
  id String @id @default(cuid())

  userId String
  gameId String

  orderItemId String?

  grantedAt DateTime @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  game Game @relation(fields: [gameId], references: [id], onDelete: Restrict)

  @@unique([userId, gameId])
  @@index([userId, revokedAt])
}

/* =========================================================
   MODERATION
   ========================================================= */

model ContentReport {
  id String @id @default(cuid())

  reporterId String

  targetType String
  targetId String

  reason ReportReason

  details String?

  status ModerationStatus @default(PENDING)

  moderatorId String?

  resolutionNote String?

  createdAt DateTime @default(now())
  resolvedAt DateTime?

  reporter User @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Restrict)
  moderator User? @relation("ModeratorReports", fields: [moderatorId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

model ModerationAction {
  id String @id @default(cuid())

  moderatorId String

  targetType String
  targetId String

  action String

  reason String?

  createdAt DateTime @default(now())

  moderator User @relation(fields: [moderatorId], references: [id], onDelete: Restrict)

  @@index([targetType, targetId, createdAt])
}

/* =========================================================
   REFERRALS
   ========================================================= */

model Referral {
  id String @id @default(cuid())

  referrerId String
  referredId String @unique

  status ReferralStatus @default(PENDING)

  rewardPoints Int @default(0)

  qualifiedAt DateTime?
  rewardedAt DateTime?

  createdAt DateTime @default(now())

  referrer User @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Restrict)
  referred User @relation("ReferralReferred", fields: [referredId], references: [id], onDelete: Restrict)

  @@index([referrerId, status, createdAt])
}

/* =========================================================
   RAFFLES
   ========================================================= */

model Raffle {
  id String @id @default(cuid())

  title String
  description String?

  prize String

  ticketCost Int @default(0)

  maxEntries Int?

  status RaffleStatus @default(DRAFT)

  drawAt DateTime?

  winnerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries RaffleEntry[]

  winner User? @relation("RaffleWinner", fields: [winnerId], references: [id], onDelete: SetNull)

  @@index([status, drawAt])
  @@index([winnerId])
}

model RaffleEntry {
  id String @id @default(cuid())

  raffleId String
  userId String

  tickets Int @default(1)

  createdAt DateTime @default(now())

  raffle Raffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([raffleId, userId])
  @@index([userId, createdAt])
}


/* =========================================================
   GAMEVORTEX VIP / SUBSCRIPTIONS
   ========================================================= */

model VipPlan {
  id String @id @default(cuid())

  code String @unique
  nameAr String
  nameEn String
  descriptionAr String?
  descriptionEn String?

  priceCents Int
  currency String @default("USD")
  durationMonths Int?

  pointsMultiplier Decimal @default(1.0) @db.Decimal(5,2)

  chatCredits Int @default(0)
  imageCredits Int @default(0)
  videoCredits Int @default(0)

  active Boolean @default(true)
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions VipSubscription[]
  rewards VipReward[]

  @@index([active, sortOrder])
}

model VipSubscription {
  id String @id @default(cuid())

  userId String
  planId String

  status VipSubscriptionStatus @default(PENDING)

  startedAt DateTime?
  expiresAt DateTime?

  paymentId String? @unique
  provider String?
  providerSubscriptionId String?

  chatCredits Int @default(0)
  imageCredits Int @default(0)
  videoCredits Int @default(0)

  lastRewardAt DateTime?
  nextRewardAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan VipPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  events VipSubscriptionEvent[]
  rewards VipRewardClaim[]
  purchase VipPurchase?

  @@index([userId, status, expiresAt])
  @@index([planId, status])
  @@index([expiresAt, status])
  @@index([provider, providerSubscriptionId])
}

model VipSubscriptionEvent {
  id String @id @default(cuid())

  subscriptionId String
  type VipSubscriptionEventType

  provider String?
  providerEventId String?

  metadata Json?

  createdAt DateTime @default(now())

  subscription VipSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([provider, providerEventId])
  @@index([subscriptionId, createdAt])
  @@index([type, createdAt])
}




model VipReward {
  id String @id @default(cuid())

  planId String?
  code String @unique
  nameAr String
  nameEn String

  points Int @default(0)
  chatCredits Int @default(0)
  imageCredits Int @default(0)
  videoCredits Int @default(0)

  active Boolean @default(true)
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan VipPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  claims VipRewardClaim[]

  @@index([planId, active])
}

model VipRewardClaim {
  id String @id @default(cuid())

  userId String
  rewardId String
  subscriptionId String?

  points Int @default(0)
  chatCredits Int @default(0)
  imageCredits Int @default(0)
  videoCredits Int @default(0)

  idempotencyKey String @unique
  claimedAt DateTime @default(now())
  metadata Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward VipReward @relation(fields: [rewardId], references: [id], onDelete: Restrict)
  subscription VipSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, claimedAt])
  @@index([rewardId, claimedAt])
}

model VipPurchase {
  id String @id @default(cuid())

  userId String
  subscriptionId String @unique

  amountCents Int
  currency String @default("USD")
  provider String
  providerPaymentId String

  status PaymentStatus @default(CREATED)
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  subscription VipSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@unique([provider, providerPaymentId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}





