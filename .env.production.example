# Copy to .env.production and replace every placeholder.
NODE_ENV=production
APP_ORIGIN=https://your-domain.example
DATABASE_URL=postgresql://gamevortex:CHANGE_ME@postgres:5432/gamevortex
AUTH_SECRET=REPLACE_WITH_64_PLUS_RANDOM_CHARACTERS
OWNER_EMAIL=owner@example.com
OWNER_USERNAME=owner
OWNER_INITIAL_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
REQUIRE_OWNER_BOOTSTRAP=1
OWNER_WITHDRAWAL_ENABLED=false
OWNER_EXTERNAL_WALLET_ADDRESS=
OWNER_POINTS_PER_USD=30
OWNER_MIN_WITHDRAW_POINTS=15
QURAN_PROVIDER_BASE_URL=
QURAN_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
PAYMENT_PROVIDER_BASE_URL=
PAYMENT_PROVIDER_SECRET=
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
# Generate with: openssl rand -base64 48
DIGITAL_KEY_ENCRYPTION_SECRET=
RATE_LIMIT_STORE=memory

# Optional distributed rate limiting (recommended with >1 app instance)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Payments: set PAYMENT_PROVIDER=stripe and a Stripe secret/webhook signing secret
STRIPE_SECRET_KEY=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# AI (OpenAI-compatible API)
AI_MODEL=default
AI_MAX_OUTPUT_TOKENS=800

# Gaming
STEAM_API_KEY=
XBOX_API_BASE_URL=
PLAYSTATION_API_BASE_URL=

# Owner payouts
PAYOUT_PROVIDER=
PAYOUT_PROVIDER_BASE_URL=
PAYOUT_PROVIDER_SECRET=

# ============================================================
# ============================================================
# GameVortex self-hosted AI server
# Keep these server-side only. Never use NEXT_PUBLIC_*.
# ============================================================

# Chat
GAMEVORTEX_AI_PROVIDER="OPENAI"
GAMEVORTEX_AI_BASE_URL=""
GAMEVORTEX_AI_API_KEY=""
GAMEVORTEX_CHAT_MODEL="gamevortex-chat"
GAMEVORTEX_AI_TIMEOUT_MS="120000"
GAMEVORTEX_AI_REASONING_EFFORT="medium"
GAMEVORTEX_AI_MAX_OUTPUT_TOKENS="2000"

# Image
GAMEVORTEX_IMAGE_PROVIDER="FAL"
GAMEVORTEX_IMAGE_BASE_URL=""
GAMEVORTEX_IMAGE_API_KEY=""
GAMEVORTEX_IMAGE_MODEL="gamevortex-image"

# Video
GAMEVORTEX_VIDEO_PROVIDER="MINIMAX"
GAMEVORTEX_VIDEO_BASE_URL=""
GAMEVORTEX_VIDEO_API_KEY=""
GAMEVORTEX_VIDEO_MODEL="gamevortex-video"

# GameVortex AI — Three-provider setup (server-side only)
# NEVER prefix these with NEXT_PUBLIC_
# ============================================================

# OpenAI — "the brain"
OPENAI_API_KEY=

# fal.ai — media (Authorization: Key <FAL_KEY>)
FAL_KEY=

# MiniMax — video/media
MINIMAX_API_KEY=
# International: https://api.minimax.io | Mainland China: https://api.minimaxi.com
MINIMAX_API_BASE_URL=

# Mobile game catalog import (server-side only)
RAWG_API_KEY=
RAWG_MOBILE_IMPORT_TARGET=1000
RAWG_MOBILE_IMPORT_PAGE_SIZE=40

# GameVortex AI media models
FAL_IMAGE_MODEL=fal-ai/flux-2/turbo
MINIMAX_VIDEO_MODEL=MiniMax-Hailuo-2.3
