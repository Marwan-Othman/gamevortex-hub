# Copy to .env.production and replace every placeholder.
NODE_ENV=production
APP_ORIGIN=https://your-domain.example
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
DATABASE_URL=postgresql://gamevortex:CHANGE_ME@postgres:5432/gamevortex
AUTH_SECRET=REPLACE_WITH_64_PLUS_RANDOM_CHARACTERS
OWNER_EMAIL=owner@example.com
OWNER_NAME=owner
OWNER_USERNAME=owner
OWNER_INITIAL_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
REQUIRE_OWNER_BOOTSTRAP=1
OWNER_WITHDRAWAL_ENABLED=false
OWNER_EXTERNAL_WALLET_ADDRESS=
OWNER_POINTS_PER_USD=30
OWNER_MIN_WITHDRAW_POINTS=15
QURAN_PROVIDER_BASE_URL=
QURAN_PROVIDER_API_KEY=
PAYMENT_PROVIDER_BASE_URL=
PAYMENT_PROVIDER_SECRET=
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
# Generate with: openssl rand -base64 48
DIGITAL_KEY_ENCRYPTION_SECRET=
RATE_LIMIT_STORE=memory

# Optional distributed rate limiting (recommended with >1 app instance)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Payments: set PAYMENT_PROVIDER=stripe and a Stripe secret/webhook signing secret
STRIPE_SECRET_KEY=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_SECRET=
PAYPAL_CLIENT_ID=
STRIPE_WEBHOOK_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Gaming
STEAM_API_KEY=
XBOX_API_BASE_URL=
PLAYSTATION_API_BASE_URL=

# Owner payouts
PAYOUT_PROVIDER=
PAYOUT_PROVIDER_BASE_URL=
PAYOUT_PROVIDER_SECRET=

# Mobile game catalog import (server-side only)
RAWG_API_KEY=
RAWG_MOBILE_IMPORT_TARGET=1000
RAWG_MOBILE_IMPORT_PAGE_SIZE=40


# GameVortex AI gateway on infrastructure you control. Vercel cannot access localhost on your phone/computer.
GAMEVORTEX_AI_RUNTIME_URL=https://ai.your-domain.example
GAMEVORTEX_AI_MODEL=qwen3:1.7b
GAMEVORTEX_AI_RUNTIME_TOKEN=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS

# Optional integrations / validation controls
FAZER_API_KEY=""
QF_CLIENT_ID=""
QF_CLIENT_SECRET=""
QF_ENV="sandbox"
OWNER_PURCHASE_POINTS="0"
REFERRAL_REFERRER_POINTS="0"
REFERRAL_REFERRED_POINTS="0"
REQUIRE_BUILD="0"
REQUIRE_LOCKFILE="1"

VALIDATE_PRODUCTION=0
